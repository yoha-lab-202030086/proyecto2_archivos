### 1. REGISTRAR USUARIO
POST http://localhost:3000/api/usuarios
Content-Type: application/json

{
    "nombre": "Ana Martinez",
    "correo": "ana@gmail.com",
    "contraseña": "123456",
    "rol": "USUARIO"
}

### 2. INICIAR SESIÓN (LOGIN)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
    "correo": "ana@gmail.com",
    "contraseña": "123456"
}

### 3. SUBIR ARCHIVO PDF
POST http://localhost:3000/api/archivos
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYzZkZDM2MGI1YmI2ODMyOGNiM2M5MyIsInJvbCI6IlVTVUFSSU8iLCJpYXQiOjE3OTE0MzEzMTcsImV4cCI6MTc5MTQ2MDExN30.9NCQU2JjKHfZ4vsxM14R0hF0pAOBpuf9z6hEl6CeFOc
Content-Type: multipart/form-data; boundary=boundary_sistema_documental

--boundary_sistema_documental
Content-Disposition: form-data; name="archivo"; filename="proyecto.pdf"
Content-Type: application/pdf

< ./servidor/package.json

--boundary_sistema_documental--

### 4. REGISTRAR SEGUNDO USUARIO (CARLOS)
POST http://localhost:3000/api/usuarios
Content-Type: application/json

{
    "nombre": "Carlos Perez",
    "correo": "carlos@gmail.com",
    "contraseña": "123456",
    "rol": "USUARIO"
}
### 5. COMPARTIR RECURSO (ANA COMPARTE A CARLOS)
POST http://localhost:3000/api/permisos
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYzZkZDM2MGI1YmI2ODMyOGNiM2M5MyIsInJvbCI6IlVTVUFSSU8iLCJpYXQiOjE3OTE3Mzg1MDIsImV4cCI6MTc5MTc2NzMwMn0.mgTt8kGLysyVm8-mqREo04tI_9Ha8o8k9-8iNb9En7c
Content-Type: application/json

{
    "recursoTipo": "ARCHIVO",
    "recursoId": "6ac70e5e615e90538f82dd80",
    "usuarioDestinoId": "6ac95e2370c066307c547bfa",
    "nivel": "LECTURA"
}

### 6. PROBAR EL RENOMBRADO
PUT http://localhost:3000/api/archivos/6ac70e5e615e90538f82dd80/renombrar
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYzZkZDM2MGI1YmI2ODMyOGNiM2M5MyIsInJvbCI6IlVTVUFSSU8iLCJpYXQiOjE3OTE3Mzg1MDIsImV4cCI6MTc5MTc2NzMwMn0.mgTt8kGLysyVm8-mqREo04tI_9Ha8o8k9-8iNb9En7c
Content-Type: application/json

{
    "nombre": "documento_importante.pdf"
}

### 7. PROBAR LA DESCARGA
GET http://localhost:3000/api/archivos/6ac70e5e615e90538f82dd80/descargar
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYzZkZDM2MGI1YmI2ODMyOGNiM2M5MyIsInJvbCI6IlVTVUFSSU8iLCJpYXQiOjE3OTE3Mzg1MDIsImV4cCI6MTc5MTc2NzMwMn0.mgTt8kGLysyVm8-mqREo04tI_9Ha8o8k9-8iNb9En7c

